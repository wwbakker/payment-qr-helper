package build

import coursier.maven.MavenRepository
import mill.*, scalalib.*, scalajslib.*

trait AppScalaModule extends ScalaModule {
  def scalaVersion = "3.9.0"
}

trait AppScalaJSModule extends AppScalaModule, ScalaJSModule {
  def scalaJSVersion = "1.22.0"
}

object api extends AppScalaModule {
  override def moduleDeps: Seq[JavaModule] = Seq(shared.jvm)

  def zioCoreVersion = "2.1.26"
  def zioHttpVersion = "3.11.6"
  def zioJsonVersion = "1.1.0"
  val tapirVersion = "1.13.31"
  override def mvnDeps = Seq(
    mvn"dev.zio::zio:$zioCoreVersion",
    mvn"dev.zio::zio-streams:$zioCoreVersion",
    mvn"dev.zio::zio-http:$zioHttpVersion",
    mvn"dev.zio::zio-json:$zioJsonVersion",
    mvn"com.softwaremill.sttp.tapir::tapir-zio-http-server:$tapirVersion",
    mvn"com.softwaremill.sttp.tapir::tapir-json-zio:$tapirVersion",
    mvn"com.github.kenglxn.QRGen:javase:3.0.1",
  )

  val jitPackRepository = MavenRepository("https://jitpack.io")

  override def repositoriesTask = Task.Anon {
    super.repositoriesTask() ++ Seq(jitPackRepository)
  }

  override def resources = Task {
    os.makeDir(Task.dest / "webapp")
    val jsPath = frontend.fastLinkJS().dest.path
    // Move main.js[.map]into the proper filesystem position
    // in the resource folder for the web server code to pick up
    os.copy(jsPath / "main.js", Task.dest / "webapp" / "main.js")
    os.copy(jsPath / "main.js.map", Task.dest / "webapp" / "main.js.map")
    super.resources() ++ Seq(PathRef(Task.dest))
  }

  object test extends ScalaTests, TestModule.ZioTest {
    // zio-test is versioned in lockstep with zio itself
    def zioTestVersion = zioCoreVersion
  }
}

object frontend extends AppScalaJSModule {
  override def moduleDeps: Seq[JavaModule] = Seq(shared.js)

  override def mvnDeps = Seq(
    mvn"com.raquo::laminar::17.2.1",
  )
}

object shared extends Module {
  trait SharedModule extends AppScalaModule, PlatformScalaModule

  object jvm extends SharedModule
  object js extends SharedModule, AppScalaJSModule
}
